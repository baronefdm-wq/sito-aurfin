# Copiare in .env.local e compilare. Nessuna credenziale va inserita in questo file.

# URL pubblico del sito (usato per canonical, sitemap e robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Accesso riservato all'intero sito (versione di presentazione online).
# Se impostata (minimo 16 caratteri), si entra solo con il link https://<dominio>/?accesso=<chiave>.
# Generarla con: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
SITE_ACCESS_KEY=

# Indirizzo dedicato allo spazio team (facoltativo), es. team.aurfin.it.
# Se impostato, /team risponde solo su quell'indirizzo e lì non si vede il sito dei clienti.
TEAM_HOST=

# Modalità revisione: mostra segnaposto e note "Da validare". Impostare a false per la pubblicazione.
NEXT_PUBLIC_REVIEW_MODE=true

# demo = database con dati sintetici e profili dimostrativi
# live = database reale, accessi con password/codice (team) e link via email (clienti)
DATA_MODE=demo

# Percorso del database (facoltativo). Predefinito: data/aurfin-demo.db o data/aurfin.db
DATABASE_PATH=

# Primo amministratore in modalità live: poi usa "Primo accesso o password dimenticata" su /team/recupero
TEAM_ADMIN_EMAIL=
TEAM_ADMIN_NAME=

# Sollecito al team se una richiesta attende il primo contatto da più di queste ore (predefinito 24)
FIRST_CONTACT_ALERT_HOURS=24

# Giorni di conservazione dei documenti di pratiche chiuse. Vuoto = nessuna cancellazione automatica.
# Il valore va deciso con il consulente privacy.
DOCUMENT_RETENTION_DAYS=

# Segreto per firmare la sessione (minimo 32 caratteri, obbligatorio in modalità live).
# Generarlo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Calendario che riceve le telefonate tramite invito via email (es. Google Calendar). Richiede SMTP_*.
CALENDAR_INVITE_TO=

# Storage documenti. "local" = cartella privata su disco (predefinito in sviluppo).
# In produzione usare uno storage privato gestito; lasciare vuoto per disattivare i caricamenti.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=

# --- Notifiche al personale (nuovi preventivi, messaggi, consulenze, proposte) ---
# Email via SMTP (es. casella aziendale). Più destinatari separati da virgola.
NOTIFY_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# WhatsApp Business Cloud API (Meta). Numeri in formato internazionale senza + (es. 393331234567).
# Il modello (template) deve essere approvato da Meta e avere due variabili: {{1}} riepilogo, {{2}} link.
NOTIFY_WHATSAPP_TO=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=it
WHATSAPP_API_VERSION=v21.0
CALENDAR_PROVIDER=
